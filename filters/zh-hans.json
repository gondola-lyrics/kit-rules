{
  "$schema": "../schema.json",
  "version": 1,
  "language": "zh-hans",
  "normalization": {
    "whitespace": "remove",
    "case": "asciiLower"
  },
  "groups": [
    {
      "id": "copyright-notice",
      "category": "copyright",
      "match": "contains",
      "words": ["侵权必究", "保留所有权利", "未经授权", "未经许可", "版权属于", "版权归", "版权所有", "翻版必究", "违者必究"]
    },
    {
      "id": "copyright-label",
      "category": "copyright",
      "match": "whole",
      "words": ["授权", "版权"]
    },
    {
      "id": "adaptation-label",
      "category": "adaptation",
      "match": "whole",
      "words": ["改编", "翻唱", "致敬"]
    },
    {
      "id": "disclaimer-notice",
      "category": "disclaimer",
      "match": "contains",
      "words": ["仅供个人", "仅供参考", "仅供学习"]
    }
  ]
}
