{
  "$schema": "../schema.json",
  "version": 1,
  "language": "zh-hans",
  "normalization": {
    "whitespace": "remove",
    "case": "asciiLower"
  },
  "groups": [
    {
      "id": "copyright-notice",
      "category": "copyright",
      "match": "contains",
      "words": [
        "版权所有",
        "保留所有权利",
        "侵权必究",
        "翻版必究",
        "违者必究",
        "未经授权",
        "未经许可",
        "版权归",
        "版权属于",
        "不得转载",
        "严禁转载",
        "盗版必究",
        "禁止转载"
      ]
    },
    {
      "id": "copyright-label",
      "category": "copyright",
      "match": "whole",
      "words": ["版权", "授权"]
    },
    {
      "id": "adaptation-label",
      "category": "adaptation",
      "match": "whole",
      "words": ["改编", "翻唱", "致敬"]
    },
    {
      "id": "disclaimer-notice",
      "category": "disclaimer",
      "match": "contains",
      "words": ["仅供学习", "仅供个人", "仅供参考", "仅供交流", "禁止商业用途", "非商业用途"]
    },
    {
      "id": "organization-label",
      "category": "organization",
      "match": "contains",
      "words": ["唱片公司", "制作公司", "发行公司", "承办单位", "次级发行方", "厂牌"]
    },
    {
      "id": "studio-label",
      "category": "studio",
      "match": "contains",
      "words": ["录音室", "录音棚", "混音室", "混音工作室", "混音录音室", "母带录音室", "母带处理录音室"]
    }
  ]
}
