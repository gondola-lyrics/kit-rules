{
  "$schema": "../schema.json",
  "version": 1,
  "language": "en",
  "normalization": {
    "whitespace": "remove",
    "case": "asciiLower"
  },
  "groups": [
    {
      "id": "copyright-notice",
      "category": "copyright",
      "match": "contains",
      "words": [
        "Allrightsofthe",
        "Allrightsreserved",
        "Nopartofthis",
        "Unauthorizedcopying",
        "Unauthorizedduplication",
        "Unauthorizedreproduction",
        "Unauthorizeduse",
        "Underexclusivelicense"
      ]
    },
    {
      "id": "copyright-label",
      "category": "copyright",
      "match": "whole",
      "words": ["Copyright", "License"]
    },
    {
      "id": "adaptation-label",
      "category": "adaptation",
      "match": "whole",
      "words": ["Adaptation", "Cover", "Remake", "Tribute"]
    },
    {
      "id": "disclaimer-notice",
      "category": "disclaimer",
      "match": "contains",
      "words": ["Foreducationalpurposes", "Fornon-commercial", "Fornoncommercial"]
    }
  ]
}
