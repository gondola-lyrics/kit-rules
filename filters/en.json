{
  "$schema": "../schema.json",
  "version": 1,
  "language": "en",
  "normalization": {
    "whitespace": "remove",
    "case": "asciiLower"
  },
  "groups": [
    {
      "id": "copyright-notice",
      "category": "copyright",
      "match": "contains",
      "words": [
        "Allrightsreserved",
        "Allrightsofthe",
        "Nopartofthis",
        "Unauthorizedreproduction",
        "Unauthorizedduplication",
        "Unauthorizedcopying",
        "Unauthorizeduse",
        "Underexclusivelicense",
        "Allrightsreservedby",
        "Anyunauthorizeduse",
        "Usedbypermission"
      ]
    },
    {
      "id": "copyright-label",
      "category": "copyright",
      "match": "whole",
      "words": ["Copyright", "License"]
    },
    {
      "id": "adaptation-label",
      "category": "adaptation",
      "match": "whole",
      "words": ["Cover", "Remake", "Tribute", "Adaptation"]
    },
    {
      "id": "disclaimer-notice",
      "category": "disclaimer",
      "match": "contains",
      "words": ["Foreducationalpurposes", "Fornon-commercial", "Fornoncommercial", "Fornonprofitable", "Forpersonaluse", "Forpromotionalpurposes"]
    },
    {
      "id": "organization-label",
      "category": "organization",
      "match": "contains",
      "words": ["ManufacturingCompany", "RecordCompany", "RecordLabel", "Distribution"]
    },
    {
      "id": "studio-label",
      "category": "studio",
      "match": "contains",
      "words": ["RecordingStudio", "MasteringStudio", "Mixingstudio", "Mixstudio", "StudioPersonnel"]
    }
  ]
}
